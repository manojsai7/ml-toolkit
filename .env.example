# Example .env file for ML Toolkit
# Copy this to .env and fill in your values

# Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=ml-toolkit

# Data Paths
DATA_DIR=./data
LOG_DIR=./logs
CHECKPOINT_DIR=./checkpoints

# Model Settings
DEVICE=cuda  # or cpu
SEED=42

# Training Settings
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=10
